{
  "name": "enterprise-agent-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @eap/web --filter @eap/business-api dev",
    "build": "pnpm --filter @eap/web build",
    "lint": "pnpm --filter @eap/web lint && pnpm --filter @eap/business-api lint",
    "typecheck": "pnpm --filter @eap/web typecheck",
    "test": "pnpm --filter @eap/business-api test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  }
}
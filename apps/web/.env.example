BUSINESS_API_URL=http://127.0.0.1:8080

LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_MS=30000

DATABASE_URL=postgresql://eap_web_runtime:REPLACE_ME@127.0.0.1:5432/eap
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
MODEL_PRICES_JSON=

# See docs/day9-security-multitenancy.md; generate secrets, never use migration credentials here.
BETTER_AUTH_URL=http://localhost:3551
BETTER_AUTH_SECRET=
BUSINESS_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Same independent key in Web and Worker; openssl rand -hex 32
AGENT_CHECKPOINT_KEY=

# Day 11: default deterministic sandbox only; external candidate/judge require explicit opt-in on both services
EVAL_ALLOW_EXTERNAL=false
EVAL_ALLOW_JUDGE=false
EVAL_CODE_REVISION=working-tree

# Same independent secret in Web instances for stable PromptOps assignment; generate with openssl rand -hex 32.
PROMPT_ROUTING_KEY=
# Set to deployment code revision on Web and Worker; changing it requires fresh prompt evaluation.
EVAL_CODE_REVISION=working-tree

# Day 13: independent from Chat provider. Mock requires no external credentials.
EMBEDDING_PROVIDER=mock

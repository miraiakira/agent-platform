# Copy to packages/persistence/.env.local. Node 24 loads it for db:migrate and db:provision-runtime.
# Migration/provisioning only: never copy this administrator URL into Web or Worker.
MIGRATION_DATABASE_URL=postgresql://eap:eap_dev_password@localhost:5432/eap
# Generate each independently with: openssl rand -hex 32
# Use these same passwords in the corresponding Web/Worker runtime DATABASE_URL.
APP_DB_PASSWORD=
WORKER_DB_PASSWORD=

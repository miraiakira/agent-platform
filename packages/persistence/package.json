{
  "name": "@eap/persistence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx src/migrate.ts",
    "db:provision-runtime": "node --env-file-if-exists=.env.local --import tsx scripts/provision-runtime.ts"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "@eap/observability": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}

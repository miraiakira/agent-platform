{
  "uid": "agent-overview",
  "title": "Agent Overview",
  "schemaVersion": 40,
  "version": 2,
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Observed runs",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(last_over_time(agent_runs_total[$__range]))",
          "instant": true,
          "range": false
        }
      ],
      "description": "Sum of the latest sampled cumulative counter per process observed in the selected range. Includes counts since each process started, not an exact increase within the range. Missing data is not assumed to be zero.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No reported samples"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Observed success ratio",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(last_over_time(agent_runs_total{status=\"completed\"}[$__range])) or (0 * sum(last_over_time(agent_runs_total[$__range])))) / sum(last_over_time(agent_runs_total[$__range]))",
          "instant": true,
          "range": false
        }
      ],
      "description": "Sum of the latest sampled cumulative counter per process observed in the selected range. Includes counts since each process started, not an exact increase within the range. Missing data is not assumed to be zero.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No reported samples"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Observed failure ratio",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(last_over_time(agent_runs_total{status!=\"completed\"}[$__range])) or (0 * sum(last_over_time(agent_runs_total[$__range])))) / sum(last_over_time(agent_runs_total[$__range]))",
          "instant": true,
          "range": false
        }
      ],
      "description": "Sum of the latest sampled cumulative counter per process observed in the selected range. Includes counts since each process started, not an exact increase within the range. Missing data is not assumed to be zero.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No reported samples"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Observed Run P50/P95/P99",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (last_over_time(agent_run_duration_seconds_bucket[$__range])))",
          "legendFormat": "P50",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (last_over_time(agent_run_duration_seconds_bucket[$__range])))",
          "legendFormat": "P95",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (last_over_time(agent_run_duration_seconds_bucket[$__range])))",
          "legendFormat": "P99",
          "instant": true,
          "range": false
        }
      ],
      "description": "Quantile of the latest cumulative histogram buckets per process sampled in the selected range. Covers those process lifetimes; not an interval-rate quantile.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "textMode": "auto",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No reported samples"
        },
        "overrides": []
      }
    },

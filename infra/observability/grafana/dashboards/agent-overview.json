        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(agent_worker_active_jobs)",
          "instant": false,
          "range": true
        }
      ],
      "description": "Recent rate or sampled active work. Zero is normal when no jobs are running; no samples means telemetry was not received in this period."
    },

{
  "uid": "day14-worker",
  "title": "Day 14 Worker \u2014 Proposed SLO / observed signals",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Live workers",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(agent_workers_live)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "NOT VERIFIED / no samples"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Active slots",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(agent_worker_active_jobs)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "NOT VERIFIED / no samples"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Lease expirations",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(worker_lease_expired_total[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "NOT VERIFIED / no samples"
        },
        "overrides": []
      }
    }
  ]
}

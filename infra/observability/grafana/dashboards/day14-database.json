{
  "uid": "day14-database",
  "title": "Day 14 Database \u2014 Proposed SLO / observed signals",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Pool connections",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(postgres_pool_connections)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "NOT VERIFIED / no samples"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Pool waiters",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(postgres_pool_waiting)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "NOT VERIFIED / no samples"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Acquisition P95",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le)(rate(postgres_pool_wait_seconds_bucket[5m])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "NOT VERIFIED / no samples"
        },
        "overrides": []
      }
    }
  ]
}

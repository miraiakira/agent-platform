{
  "uid": "day14-slo",
  "title": "Day 14 Slo \u2014 Proposed SLO / observed signals",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Proposed API availability (30d)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - sum(increase(http_requests_total{status=\"server_error\"}[30d])) / sum(increase(http_requests_total{status=~\"success|server_error\"}[30d]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "NOT VERIFIED / no samples"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "5m burn rate",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "eap:api_error_ratio:5m / 0.001"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "NOT VERIFIED / no samples"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "1h burn rate",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "eap:api_error_ratio:1h / 0.001"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "NOT VERIFIED / no samples"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Submission accepted fraction",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(agent_submission_total{status=\"accepted\"}[5m])) / sum(rate(agent_submission_total{status!=\"invalid_or_denied\"}[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "NOT VERIFIED / no samples"
        },
        "overrides": []
      }
    }
  ]
}

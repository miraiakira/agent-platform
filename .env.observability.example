# Export these values separately in the Web and Worker shells. Never commit real keys.
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/json
# Optional: JSON array of operator-maintained, effective-dated per-million prices.
# Empty configuration knows only the explicitly free mock model; other models have unknown cost.
MODEL_PRICES_JSON=
# Optional Grafana admin bootstrap password; base Compose disables anonymous access.
# Only the explicit compose.observability-local.yaml override enables local anonymous Viewer.
GRAFANA_ADMIN_PASSWORD=

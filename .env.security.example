# Copy relevant values to apps/web/.env.local and services/agent-worker/.env.local.
# Never put the migration identity in a Web or Worker environment.
# Migration shell only:
MIGRATION_DATABASE_URL=postgresql://eap:eap_dev_password@127.0.0.1:5432/eap
APP_DB_PASSWORD=
WORKER_DB_PASSWORD=
# Web only; URL-encode the password:
DATABASE_URL=postgresql://eap_web_runtime:REPLACE_ME@127.0.0.1:5432/eap
BETTER_AUTH_URL=http://localhost:3551
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Worker uses its own URL instead:
# DATABASE_URL=postgresql://eap_worker_runtime:REPLACE_ME@127.0.0.1:5432/eap
LLM_PROVIDER=mock
BUSINESS_API_URL=http://127.0.0.1:8080
# Same random 32+ character service secret in Compose, Web and Worker:
BUSINESS_API_KEY=
# Integration-test provisioner only; never a runtime URL:
TEST_DATABASE_URL=postgresql://eap:eap_dev_password@127.0.0.1:5432/eap_test
